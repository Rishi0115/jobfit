# ==============================================================================
# JobFit — Environment Variables Example
# Duplicate this file to .env.local and populate with your actual development values.
# NEVER commit .env or .env.local with real secrets into source control.
# ==============================================================================

# Database
DATABASE_URL="postgresql://jobfit_user:jobfit_password@localhost:5432/jobfit?schema=public"

# Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js (NextAuth v5) Configuration
# Generate a secret via: `npx auth secret` or `openssl rand -base64 32`
AUTH_SECRET="replace-with-a-secure-random-32-character-secret"
AUTH_URL="http://localhost:3000/api/auth"

# OAuth Providers (Optional for local dev)
AUTH_GOOGLE_ID="your-google-client-id"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Storage Configuration (AWS S3 or S3-compatible like MinIO/R2)
STORAGE_PROVIDER="s3"
AWS_ACCESS_KEY_ID="minioadmin"
AWS_SECRET_ACCESS_KEY="minioadmin"
AWS_S3_BUCKET="jobfit-resumes"
AWS_S3_REGION="us-east-1"
AWS_S3_ENDPOINT="http://localhost:9000"

# AI Provider Configuration ("openai" or "gemini")
AI_PROVIDER="openai"
OPENAI_API_KEY="your-openai-api-key"
GEMINI_API_KEY="your-gemini-api-key"
